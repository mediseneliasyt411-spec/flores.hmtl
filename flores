<!DOCTYPE html><html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Flores Amarillas · 21 de septiembre</title>
  <!-- Tailwind vía CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- Anime.js para animaciones -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/animejs/3.2.1/anime.min.js"></script>
  <style>
    body { font-family: 'Segoe UI', sans-serif; }
    .petal {
      position: absolute;
      width: 24px;
      height: 24px;
      background: radial-gradient(circle, #facc15 40%, #f59e0b 100%);
      border-radius: 50%;
      opacity: 0.8;
      pointer-events: none;
    }
  </style>
</head>
<body class="min-h-screen flex items-center justify-center bg-gradient-to-b from-yellow-50 via-yellow-100 to-white p-6">
  <div class="max-w-2xl w-full bg-white/90 rounded-2xl shadow-2xl p-6 relative overflow-hidden">
    <h1 class="text-3xl font-extrabold text-yellow-800 mb-2 text-center">🌼 Flores Amarillas 🌼</h1>
    <p class="text-yellow-700/80 text-center mb-6">21 de septiembre · Un día para dedicar con cariño</p><div id="card" class="rounded-xl p-6 border border-yellow-200 bg-gradient-to-b from-white to-yellow-50 shadow-md">
  <h2 id="recipient" class="text-2xl font-bold text-yellow-900 text-center mb-4">A ti</h2>
  <p id="message" class="text-yellow-900/95 leading-relaxed text-center">
    Que estas flores amarillas te recuerden luz, esperanza y nuevos comienzos. Feliz 21 de septiembre.
  </p>

  <div class="mt-6 flex justify-center gap-3">
    <button onclick="celebrate()" class="px-4 py-2 rounded-lg bg-yellow-500 text-white shadow hover:scale-105 transition">Celebrar</button>
    <button onclick="copyText()" class="px-4 py-2 rounded-lg bg-yellow-100 text-yellow-900 border border-yellow-300">Copiar texto</button>
  </div>
</div>

<div class="mt-6 text-center text-sm text-yellow-700/80">Diseñado con cariño · 21 de septiembre · Flores amarillas 🌼</div>

  </div>  <script>
    function createPetal() {
      const petal = document.createElement("div");
      petal.classList.add("petal");
      petal.style.left = Math.random() * window.innerWidth + "px";
      petal.style.top = "-20px";
      document.body.appendChild(petal);

      anime({
        targets: petal,
        translateY: window.innerHeight + 40,
        duration: 4000 + Math.random() * 2000,
        easing: "linear",
        opacity: [1, 0],
        complete: () => petal.remove()
      });
    }

    function celebrate() {
      for (let i = 0; i < 30; i++) {
        setTimeout(createPetal, i * 100);
      }
    }

    function copyText() {
      const text = document.getElementById("recipient").innerText + " — " + document.getElementById("message").innerText;
      navigator.clipboard.writeText(text).then(() => alert("Texto copiado al portapapeles"));
    }
  </script></body>
</html>
